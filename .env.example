# For development: copy to `.env` and fill in. `vp dev` and `bun src/cli/index.ts …` read it, but
# the built binary never does; in production these are set in the environment (e.g. by
# /etc/swiftace.env, which `swiftace deploy` creates). Variables already set in the environment win
# over this file. Everything else, including the keys for login providers, Stripe, Turnstile,
# PostHog and OpenAI, is set by an admin at /manage/config.

# Postgres. Create the tables with `vp run db:migrate`.
DATABASE_URL=postgres://user:password@localhost:5432/swiftace

# Long random strings, e.g. from `openssl rand -hex 32`. Changing JWT_SECRET_KEY signs everyone out;
# changing HASH_SECRET_KEY voids pending sign-in codes and links.
JWT_SECRET_KEY=
HASH_SECRET_KEY=

# Amazon SES, which sends every email from notify@EMAIL_DOMAIN. Verify that domain in SES first.
AWS_ACCESS_KEY_ID=
AWS_ACCESS_KEY_SECRET=
AWS_REGION=us-east-1
EMAIL_DOMAIN=example.com

# Cloudflare R2 (or any S3-compatible store), for branding images, review photos, course images
# and certificates. The app serves what it needs from it, so the bucket doesn't need to be public.
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# The notebook preview, which runs notebook outputs' scripts on a domain of its own. In
# development `vp run dev:preview` serves it here; in production `swiftace start` does.
NOTEBOOK_PREVIEW_URL=http://localhost:4100

# Read by `swiftace start` (and `vp run dev:preview`), shown with their defaults.
# PORT=4000
# HOST=                            every address
# PREVIEW_PORT=4100                0 turns the notebook preview off
# PREVIEW_ALLOWED_PARENT_ORIGINS=  the site's origin, e.g. https://example.com (required)
